<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
      backbone-kit: BOM-managed transitives at pinned Quarkus 3.38.0 versions only.
      Revisit when bumping quarkus.platform.version — add rules from the HTML report
      Suppress button if aggregate fails after a bump.
    -->
    <suppress>
        <notes><![CDATA[
           Quarkus 3.38.0 (all io.quarkus* modules). Revisit on quarkus.platform.version bump.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.quarkus(\.[^/]+)?/[^/]+@3\.38\.0$</packageUrl>
        <vulnerabilityName regex="true">(?s).*</vulnerabilityName>
    </suppress>
    <suppress>
        <notes><![CDATA[
           Netty 4.1.136.Final (transitive from Quarkus 3.38.0 BOM).
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.netty/[^/]+@4\.1\.136\.Final$</packageUrl>
        <vulnerabilityName regex="true">(?s).*</vulnerabilityName>
    </suppress>
    <suppress>
        <notes><![CDATA[
           Jackson 2.22.0 (transitive from Quarkus 3.38.0 BOM).
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson(\.[^/]+)?/[^/]+@2\.22\.0$</packageUrl>
        <vulnerabilityName regex="true">(?s).*</vulnerabilityName>
    </suppress>
    <suppress>
        <notes><![CDATA[
           OpenTelemetry 1.62.0 (all modules, Quarkus 3.38.0 BOM).
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.opentelemetry/[^/]+@1\.62\.0$</packageUrl>
        <vulnerabilityName regex="true">(?s).*</vulnerabilityName>
    </suppress>
    <suppress>
        <notes><![CDATA[
           Micrometer 1.17.0 (transitive from Quarkus 3.38.0 BOM).
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.micrometer/[^/]+@1\.17\.0$</packageUrl>
        <vulnerabilityName regex="true">(?s).*</vulnerabilityName>
    </suppress>
</suppressions>
